<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>Capture images, camera poses, and scene depth for on-device 3D reconstruction.</string>
	<!-- Puts the app's Documents folder in Files, so a dataset can be dropped
	     in from a Mac and the exported PLY picked back up. Xcode's
	     INFOPLIST_KEY_ settings do not cover this key, so it needs a file. -->
	<key>UIFileSharingEnabled</key>
	<true/>
</dict>
</plist>
